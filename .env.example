# Optional. Nothing here is secret.

# Canonical site URL used for metadata, sitemap and structured data.
# Defaults to the Vercel production URL when unset.
# NEXT_PUBLIC_SITE_URL=https://www.example.com.au

# LAUNCH SWITCH — leave unset (or "false") while the site is a client preview.
# Set to "true" only after the business approves a public launch.
# NEXT_PUBLIC_SITE_INDEXABLE=false
